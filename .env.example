# Copiez ce fichier en .env (jamais commité) et remplacez les valeurs factices.
# Toutes les valeurs ci-dessous sont des exemples : aucune n'est un vrai secret.

# --- Obligatoire ---
# Clé maître : 32 octets en base64 (openssl rand -base64 32). Chiffre les clés privées SSH et les secrets.
# Sans elle, ces secrets sont irrécupérables : conservez-la hors de la sauvegarde de la base.
LEASSH_MASTER_KEY=remplacez-par-la-sortie-de-openssl-rand-base64-32

# --- Facultatif ---
# Jeton d'initialisation d'une instance neuve (openssl rand -base64 24). Vide : généré et affiché une fois dans les logs.
LEASSH_SETUP_TOKEN=

# Signale une nouvelle version dans l'interface (appel quotidien à l'API des releases GitHub). false = désactivé.
LEASSH_UPDATE_CHECK=true

# Adresse d'écoute du serveur (image Docker : :8080).
LEASSH_LISTEN=127.0.0.1:8080

# Répertoire de la base SQLite (image Docker : /data).
LEASSH_DATA_DIR=/var/lib/leassh

# --- Synthèse IA du rapport d'audit (facultatif, désactivée tant qu'on ne l'active pas dans l'interface) ---
# API compatible OpenAI (/v1/chat/completions), via le proxy d'IA du socle (LiteLLM). Ces valeurs servent de
# défauts : ce qui est saisi dans Réglages → Audit les remplace.
LLM_BASE_URL=http://litellm.example.lan:4000/v1
# Clé dédiée à ce projet, limitée au modèle nécessaire.
LLM_API_KEY=sk-exemple-remplacez-moi
LLM_MODEL=nom-du-modele
